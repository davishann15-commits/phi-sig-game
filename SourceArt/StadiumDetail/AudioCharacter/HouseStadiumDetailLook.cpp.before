  FHallImage Enamel,EnamelN;Enamel.Init(1024,1024,{.048f,.068f,.043f});TArray<float> EnamelH;EnamelH.SetNum(1024*1024);ParallelFor(1024,[&](int32 Y){for(int32 X=0;X<1024;++X){const float G=HallNoise(X*.8f,Y*.8f,1942),Age=HallFbm(X*.006f,Y*.0065f,3,1938),Chip=HallFbm(X*.03f,Y*.032f,4,1961),Fine=HallNoise(X*.7f,Y*.7f,1971);FLinearColor C=FLinearColor(.048f,.068f,.043f)*(.75f+Age*.45f);const bool Lost=Chip>.64f&&Fine>.55f;if(Lost)C=FLinearColor(.070f,.038f,.016f)*(.7f+G*.3f);Enamel.At(X,Y)=C;EnamelH[Y*1024+X]=G*.025f+(Lost?.04f:0);}});HallHeightToNormal(EnamelH,1024,1024,.25f,true,EnamelN);L::Texture(Look,TEXT("SD_CoachEnamel"),Enamel,.88f,.15f,&EnamelN);
  FHallImage Brass;Brass.Init(128,128,{.22f,.15f,.06f});ParallelFor(128,[&](int32 Y){for(int32 X=0;X<128;++X){const float Age=HallFbm(X*.035f,Y*.04f,3,1931);Brass.At(X,Y)=FLinearColor(.25f,.17f,.064f)*(.55f+Age*.7f);}});L::Texture(Look,TEXT("SD_CoachBrass"),Brass,.77f,.65f);
  FHallImage OldPaper;OldPaper.Init(256,256,{.45f,.37f,.23f});ParallelFor(256,[&](int32 Y){for(int32 X=0;X<256;++X){const float G=HallNoise(X*2.f,Y*2.f,1986),Stain=HallFbm(X*.022f,Y*.035f,3,1979),Edge=FMath::Min(FMath::Min(X,255-X),FMath::Min(Y,255-Y))/24.f;OldPaper.At(X,Y)=FLinearColor(.49f,.41f,.27f)*(.75f+G*.1f+Stain*.2f)*FMath::Clamp(Edge,.65f,1.f);}});L::Texture(Look,TEXT("SD_CoachPaper"),OldPaper,.99f);
  HallMakePlain(Look,TEXT("SD_CoachManila"),{.36f,.255f,.105f},.98f);
  if(auto* Snapshot=LoadObject<UTexture2D>(nullptr,TEXT("/Game/SeniorSendOff/Calder/Stadium/Textures/T_Stadium_CoachSnapshot.T_Stadium_CoachSnapshot")))HallMakeTextured(Look,TEXT("SD_CoachSnapshot"),Snapshot,nullptr,.97f,{.75f,.73f,.69f},0);else Look->Materials.Add(TEXT("SD_CoachSnapshot"),Look->Mat(TEXT("SD_CoachPaper")));
  FHallImage Clippings;Clippings.Init(768,768,{.40f,.34f,.23f});
  const TCHAR* Lines[9][4]={{TEXT("SAT OCT 18"),TEXT("24 - 17"),TEXT("KEEP THIS ONE"),TEXT("GO GEESE")},{TEXT("PRACTICE"),TEXT("MONDAY 6 AM"),TEXT("NO EXCUSES"),TEXT("- COACH")},{TEXT("LOST KEYS"),TEXT("BRASS RING"),TEXT("CHECK THE"),TEXT("BUS BAY")},{TEXT("DUNMORE"),TEXT("SCOUTING"),TEXT("BLITZ ON"),TEXT("THIRD DOWN")},{TEXT("TEAM BUS"),TEXT("LEAVES 6:15"),TEXT("AWAY GAME"),TEXT("DO NOT BE LATE")},{TEXT("EQUIPMENT"),TEXT("RETURN ALL"),TEXT("BY MONDAY"),TEXT("THANK YOU")},{TEXT("CALL"),TEXT("MAINTENANCE"),TEXT("LEAK BY"),TEXT("TUNNEL")},{TEXT("1978 TEAM"),TEXT("LEAGUE"),TEXT("CHAMPIONS"),TEXT("CALDER STATE")},{TEXT("TO COACH"),TEXT("THANK YOU"),TEXT("SENIORS"),TEXT("CLASS OF 86")}};
  for(int32 Cell=0;Cell<9;++Cell){FHallImage Note;const FLinearColor Base=Cell%3==0?FLinearColor(.48f,.40f,.25f):Cell%3==1?FLinearColor(.52f,.43f,.20f):FLinearColor(.33f,.39f,.37f);Note.Init(256,256,Base);for(int32 Y=0;Y<256;++Y)for(int32 X=0;X<256;++X){const float Grain=HallNoise(X*1.2f,Y*1.2f,1931+Cell),Stain=HallFbm(X*.025f,Y*.02f,3,1978+Cell);Note.At(X,Y)=Base*(.79f+Stain*.25f+Grain*.055f);}for(int32 Line=0;Line<4;++Line){FHallTextStyle Style;Style.Height=Line==0?21:17;Style.Stroke=Style.Height*.065f;Style.Wobble=Cell%2?1.1f:.15f;Style.Seed=1986+Cell*7+Line;const FString Text(Lines[Cell][Line]);HallDrawText(Note,Text,{(256-HallTextWidth(Text,Style))*.5f,52.f+Line*47},Style,{.055f,.04f,.025f});}Note.Stroke({{18,71},{238,71}},.7f,{.18f,.13f,.07f});for(int32 Y=0;Y<256;++Y)for(int32 X=0;X<256;++X)Clippings.At((Cell%3)*256+X,(Cell/3)*256+Y)=Note.At(X,Y);}
  L::Texture(Look,TEXT("SD_CoachClippings"),Clippings,.98f,0,nullptr,false);
  FHallImage Roster;Roster.Init(512,768,{.46f,.39f,.26f});ParallelFor(768,[&](int32 Y){for(int32 X=0;X<512;++X){const float G=HallNoise(X*.8f,Y*.8f,1985),A=HallFbm(X*.015f,Y*.012f,3,1977);Roster.At(X,Y)=FLinearColor(.48f,.405f,.275f)*(.77f+G*.11f+A*.23f);}});L::Label(Roster,TEXT("CALDER STATE"),60,34,{.075f,.06f,.045f});L::Label(Roster,TEXT("FOOTBALL"),110,28,{.075f,.06f,.045f});L::Label(Roster,TEXT("OCTOBER 18 1986"),155,21,{.075f,.06f,.045f});L::Label(Roster,TEXT("POSTGAME NOTES"),220,27,{.075f,.06f,.045f});
  const TCHAR* Rows[]={TEXT("12 WARD      QB"),TEXT("24 BELL      HB"),TEXT("37 REED      FB"),TEXT("41 FINCH     LB"),TEXT("56 MASON     C"),TEXT("63 GREER     G"),TEXT("78 COLE      T")};for(int32 J=0;J<7;++J){L::Label(Roster,Rows[J],290+J*46,22,{.10f,.085f,.06f});Roster.Stroke({{45,300.f+J*46},{467,300.f+J*46}},.7f,{.34f,.31f,.24f});}L::Label(Roster,TEXT("RETURN EQUIPMENT MONDAY"),680,20,{.17f,.085f,.055f});L::Texture(Look,TEXT("SD_CoachRoster"),Roster,.95f,0,nullptr,false);

  // Aged black moulding, fine surface scratches and one shared period paper atlas for the new office items.
  FHallImage Bakelite,BakeliteN;Bakelite.Init(256,256,{.018f,.016f,.013f});TArray<float> PlasticH;PlasticH.SetNum(256*256);ParallelFor(256,[&](int32 Y){for(int32 X=0;X<256;++X){const float G=HallNoise(X*2.f,Y*2.f,1948),Rub=HallFbm(X*.022f,Y*.03f,3,1956);Bakelite.At(X,Y)=FLinearColor(.018f,.016f,.013f)*(.80f+Rub*.35f+G*.06f);PlasticH[Y*256+X]=G*.008f;}});HallHeightToNormal(PlasticH,256,256,.12f,true,BakeliteN);L::Texture(Look,TEXT("SD_PhoneBakelite"),Bakelite,.34f,0,&BakeliteN);HallMakePlain(Look,TEXT("SD_PhoneMetal"),{.32f,.30f,.25f},.43f,.72f);
  FHallImage OfficeAtlas;OfficeAtlas.Init(1024,1024,{.35f,.29f,.18f});
  for(int32 Cell=0;Cell<4;++Cell){FHallImage Sheet;const FLinearColor Paper=Cell==3?FLinearColor(.10f,.038f,.14f):FLinearColor(.58f,.515f,.36f);Sheet.Init(512,512,Paper);for(int32 Y=0;Y<512;++Y)for(int32 X=0;X<512;++X){const float Grain=HallNoise(X*1.1f,Y*1.1f,1931+Cell),Age=HallFbm(X*.016f,Y*.02f,3,1968+Cell),Edge=FMath::Clamp(FMath::Min(FMath::Min(X,511-X),FMath::Min(Y,511-Y))/22.f,.72f,1.f);Sheet.At(X,Y)=Paper*(.83f+Age*.23f+Grain*.055f)*Edge;}
   const FLinearColor Ink(.075f,.058f,.035f);
   if(Cell==0){Sheet.Stroke({{22,22},{490,22},{490,490},{22,490},{22,22}},3,{.26f,.17f,.067f});Sheet.Stroke({{31,31},{481,31},{481,481},{31,481},{31,31}},1,{.26f,.17f,.067f});L::Label(Sheet,TEXT("CALDER STATE"),83,36,Ink);L::Label(Sheet,TEXT("ATHLETIC DEPARTMENT"),128,22,Ink);L::Label(Sheet,TEXT("COACH OF THE YEAR"),222,29,Ink);L::Label(Sheet,TEXT("MARTIN HALE"),286,28,Ink);L::Label(Sheet,TEXT("1978"),345,35,Ink);Sheet.Stroke({{77,420},{107,407},{127,419},{151,403},{165,416},{181,410},{207,420}},1.4f,Ink);Sheet.Stroke({{310,418},{326,405},{340,419},{353,403},{365,416},{390,409},{433,421}},1.3f,Ink);L::Label(Sheet,TEXT("CALDER ATHLETICS ASSOCIATION"),459,13,Ink);}
   if(Cell==1){L::Label(Sheet,TEXT("CALDER HARDWARE"),42,30,Ink);L::Label(Sheet,TEXT("OCTOBER 1986"),97,31,Ink);const TCHAR* Days[]={TEXT("S"),TEXT("M"),TEXT("T"),TEXT("W"),TEXT("T"),TEXT("F"),TEXT("S")};for(int32 X=0;X<7;++X){FHallTextStyle Style;Style.Height=18;Style.Stroke=1.1f;HallDrawText(Sheet,Days[X],{48.f+X*65,140},Style,Ink);}for(int32 Y=0;Y<6;++Y)Sheet.Stroke({{28,158.f+Y*54},{485,158.f+Y*54}},.8f,{.28f,.24f,.16f});for(int32 X=0;X<8;++X)Sheet.Stroke({{28.f+X*65,158},{28.f+X*65,428}},.7f,{.28f,.24f,.16f});for(int32 Day=1;Day<=31;++Day){const int32 Index=Day+2,Col=Index%7,Row=Index/7;FHallTextStyle Style;Style.Height=23;Style.Stroke=1.4f;HallDrawText(Sheet,FString::FromInt(Day),{39.f+Col*65,189.f+Row*54},Style,Ink);if(Day==18){TArray<FVector2D> Circle;for(int32 J=0;J<=40;++J){const float T=J*2*PI/40;Circle.Add({57.f+Col*65+FMath::Cos(T)*24,178.f+Row*54+FMath::Sin(T)*21});}Sheet.Stroke(Circle,2.0f,{.30f,.044f,.025f});}}L::Label(Sheet,TEXT("HOME GAME - 18TH"),468,22,{.24f,.05f,.032f});}
   if(Cell==2){const TCHAR* Letters[]={TEXT(""),TEXT("ABC"),TEXT("DEF"),TEXT("GHI"),TEXT("JKL"),TEXT("MNO"),TEXT("PRS"),TEXT("TUV"),TEXT("WXY"),TEXT("OPERATOR")};for(int32 J=0;J<10;++J){const float A=(45.f+J*30.f)*PI/180.f;FHallTextStyle Style;Style.Height=28;Style.Stroke=1.8f;const FString Number=FString::FromInt((J+1)%10);HallDrawText(Sheet,Number,{256+FMath::Cos(A)*235-HallTextWidth(Number,Style)*.5f,268-FMath::Sin(A)*235},Style,Ink);Style.Height=10;Style.Stroke=.7f;const FString Text=Letters[J];HallDrawText(Sheet,Text,{256+FMath::Cos(A)*209-HallTextWidth(Text,Style)*.5f,260-FMath::Sin(A)*209},Style,Ink);}L::Label(Sheet,TEXT("CALDER"),248,14,Ink);L::Label(Sheet,TEXT("555-0186"),271,14,Ink);for(int32 J=0;J<32;++J){const float T0=J*2*PI/32,T1=(J+1)*2*PI/32;Sheet.Stroke({{256+FMath::Cos(T0)*80,256+FMath::Sin(T0)*80},{256+FMath::Cos(T1)*80,256+FMath::Sin(T1)*80}},1.5f,Ink);}}
   if(Cell==3){Sheet.Stroke({{24,32},{475,256},{24,480}},8,{.47f,.33f,.095f});L::Label(Sheet,TEXT("CALDER"),210,49,{.57f,.43f,.17f});L::Label(Sheet,TEXT("GEESE"),277,45,{.57f,.43f,.17f});L::Label(Sheet,TEXT("1978"),329,25,{.57f,.43f,.17f});}
   for(int32 Y=0;Y<512;++Y)for(int32 X=0;X<512;++X)OfficeAtlas.At((Cell%2)*512+X,(Cell/2)*512+Y)=Sheet.At(X,Y);
  }
  L::Texture(Look,TEXT("SD_CoachWallDetails"),OfficeAtlas,.96f,0,nullptr,false);

  // Printed, folded homecoming program. The unit-cube top has UV[-.5,.5], so wrap the authored cover by half a tile.
  FHallImage Cover;Cover.Init(512,384,{.57f,.51f,.36f});ParallelFor(384,[&](int32 Y){for(int32 X=0;X<512;++X){const float Grain=HallNoise(X*2.f,Y*2.f,1986),Crease=FMath::Exp(-FMath::Square((X-254.f)/2.7f));Cover.At(X,Y)=FLinearColor(.57f,.51f,.36f)*(.93f+Grain*.08f-Crease*.10f);}});
  L::Label(Cover,TEXT("CALDER STATE"),53,40,{.095f,.046f,.13f});L::Label(Cover,TEXT("HOMECOMING 86"),103,32,{.095f,.046f,.13f});Cover.Stroke({{28,122},{484,122}},2,{.17f,.10f,.12f});L::Label(Cover,TEXT("FIGHTING GEESE"),165,32,{.095f,.046f,.13f});L::Label(Cover,TEXT("VS DUNMORE"),211,29,{.095f,.046f,.13f});L::Label(Cover,TEXT("SATURDAY OCTOBER 18 1986"),260,18,{.12f,.075f,.075f});L::Label(Cover,TEXT("CALDER STATE STADIUM"),300,21,{.12f,.075f,.075f});L::Label(Cover,TEXT("OFFICIAL PROGRAM  50C"),350,18,{.12f,.075f,.075f});
  FHallImage Wrapped;Wrapped.Init(512,384,FLinearColor::White);ParallelFor(384,[&](int32 Y){for(int32 X=0;X<512;++X)Wrapped.At(X,Y)=Cover.At((X+256)%512,(Y+192)%384);});L::Texture(Look,TEXT("SD_MovingProgram"),Wrapped,.96f);

  FHallImage Stripe;Stripe.Init(1024,128,{.10f,.055f,.12f});ParallelFor(128,[&](int32 Y){for(int32 X=0;X<1024;++X){const float Fine=HallNoise(X*.75f,Y*.7f,31),Patch=HallFbm(X*.015f,Y*.07f,3,1986);auto C=FLinearColor(.13f,.073f,.15f)*(.8f+Patch*.35f);if(Y>106&&Y<116)C={.43f,.32f,.12f};if(Fine>.78f||Patch>.68f)C=FLinearColor(.48f,.45f,.36f)*(.8f+Fine*.2f);Stripe.At(X,Y)=C;}});L::Texture(Look,TEXT("SD_RoomStripe"),Stripe,.94f);
  FHallImage Notes;Notes.Init(1024,768,{.16f,.091f,.042f});ParallelFor(768,[&](int32 Y){for(int32 X=0;X<1024;++X)Notes.At(X,Y)=FLinearColor(.21f,.124f,.060f)*(.7f+HallNoise(X*.7f,Y*.7f,1931)*.45f);});
  Notes.FillPolygon({{45,46},{587,35},{601,392},{53,405}},{.58f,.52f,.38f});Notes.FillPolygon({{633,74},{965,94},{950,335},{619,312}},{.64f,.59f,.43f});Notes.FillPolygon({{402,447},{951,422},{966,704},{414,718}},{.69f,.64f,.49f});Notes.FillPolygon({{65,452},{335,469},{322,706},{52,689}},{.46f,.39f,.22f});
  auto Note=[&](const TCHAR* T,float X,float Y,float H,bool Hand=false){FHallTextStyle S;S.Height=H;S.Stroke=H*(Hand?.063f:.065f);S.Spacing=.18f;S.Wobble=Hand?1.25f:.2f;S.Seed=int32(X+Y)+1986;HallDrawText(Notes,T,{X,Y},S,{.075f,.061f,.043f});};
  Note(TEXT("CALDER CHRONICLE"),77,100,39);Note(TEXT("SATURDAY OCT 18 1986"),78,141,22);Notes.Stroke({{76,155},{565,155}},2,{.12f,.10f,.06f});Note(TEXT("GEESE HOLD ON"),78,210,41);Note(TEXT("24 - 17"),115,283,61);Note(TEXT("HOMECOMING AT CALDER"),79,332,22);Note(TEXT("ONE LAST HOME GAME"),79,373,22);
  Note(TEXT("MONDAY 8 AM"),660,146,30,true);Note(TEXT("RETURN ALL"),649,200,29,true);Note(TEXT("EQUIPMENT"),645,249,30,true);Note(TEXT("- COACH"),686,292,26,true);
  Note(TEXT("WARD - CALL HOME"),444,503,32,true);Note(TEXT("MOM SAVED THE PAPER"),440,558,28,true);Note(TEXT("KEEP THE GAME BALL"),440,617,29,true);Note(TEXT("THANK YOU SENIORS"),440,672,29,true);
  Note(TEXT("1978"),95,514,39);Note(TEXT("LEAGUE"),81,569,31);Note(TEXT("CHAMPS"),74,618,32);Note(TEXT("CALDER STATE"),70,662,19);L::Texture(Look,TEXT("SD_RoomNotices"),Notes,.97f,0,nullptr,false);
