+    const FVector2D Pier=ChapterDisplayPier(P);
+    const float Start=(Pier.X+Pier.Y-245.f)*.5f,Wall=P.H.R-31.5f;
+    TrophyCase(S,G,FVector(Wall,Start+77.5f,P.Z),FVector(-1,0,0),155);
