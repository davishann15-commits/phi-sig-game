+        HouseCampusFallKit::Bar(M, TEXT("CP_SteelDark"), Base + Off2, Base + Off * .9f + Up(380.f), 3.f, 3.f, FVector::UpVector);
+    }
+    M.Cylinder(TEXT("CP_SteelDark"), Base + Up(420.f), Base + Up(432.f), 200.f, 20, Plain());
