+        {
+            const float YA = W.Max.Y + Run * K, YB = YA + Run;
+            Box(Solid, TEXT("CI_Oak"), FVector(XG - 4.f, FMath::Min(YA, YB), F0), FVector(XG + 4.f, FMath::Max(YA, YB), F0 + Rise * (K + 1) + 92.f));
