+    R.Add({ EStep::Walk, P(70.f, 45.f), Floor, TEXT("the doorway"), nullptr, nullptr });
+    R.Add({ EStep::Walk, P(70.f, -100.f), Floor, TEXT("out to the corridor"), nullptr, nullptr });
