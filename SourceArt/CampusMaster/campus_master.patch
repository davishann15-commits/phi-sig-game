+                    const float Low = FMath::Min(Rm.R.Min.Y, Next ? Next->R.Min.Y : Rm.R.Min.Y);
+                    Wall(true, East, Low - (Low > P.In.Min.Y + 1.f ? H : 0.f), P.CorBack - H, {}, 213.f);
