+    for (const HouseCampusLayoutImpl::FRun& W : HouseCampusLayoutImpl::Walks())
+        if (HouseCampusLayoutImpl::RunBuilt(W) && HouseCampusLayoutImpl::RunVisible(W)) Out.Add({ W.A, W.B, W.W });
