+        BI::AppendTransformed(P.Far, M, B.T);
+        BI::AppendTransformed(P.Glow, Glow, B.T);
+        BI::AppendTransformed(P.Detail, Dm, B.T);
+        BI::AppendTransformed(P.Solid, S, B.T);
+    }
+}
