+    // The shell's own openings (BaseStage's door, Shaft's low lancet and pair), unfilled.
+    CT::FOpening Door; Door.U = 0.f; Door.W = 95.f; Door.Sill = 75.f; Door.Spring = 330.f; Door.Sharp = .9f;
