+    for (int32 I = 0; I < 5; ++I) Kit.Floor(EKit::PaperCup, FVector2D(3360.f + (I % 3) * 15.f, In1 - 70.f + (I / 3) * 15.f), Z + 76.f, 0.f, true);
+    for (float X = 400.f; X < 4600.f; X += 600.f) Troffer(Glow, Clutter, FVector(X, (In0 + In1) * .5f, StaPBCeil - .6f), true);
+}
