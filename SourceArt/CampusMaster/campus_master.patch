+            const FVector S0 = C.At(0.f, 9.f, 1000.f), S1 = C.At(C.Len, 9.f, 1000.f), S2 = O.At(O.Len, -1.f, 1000.f), S3 = O.At(0.f, -1.f, 1000.f);
