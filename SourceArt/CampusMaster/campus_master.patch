+        F.Face(Glow, TEXT("CI_CrtScreen"), 25.3f, -36.f, 16.f, 31.f, 69.f);
+        F.B(Solid, TEXT("CI_Grille"), 24.6f, 34.f, 46.f, .5f, 11.f, 30.f);
