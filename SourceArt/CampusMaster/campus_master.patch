+    PaintText(Look, TEXT("CP_FountainSign"), 128, 70, FLinearColor(.85f, .84f, .78f), FLinearColor(.1f, .1f, .12f), { { TEXT("DRAINED"), .26f }, { TEXT("FOR THE SEASON"), .16f } }, true);
