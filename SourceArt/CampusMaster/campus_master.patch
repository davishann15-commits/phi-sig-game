+        const bool bWest = W.Min.X < 0.f;
+        const float XG = bWest ? W.Max.X : W.Min.X;
+        const int32 N = FMath::CeilToInt((F1 - F0) / 17.5f);
+        const float Run = (W.Min.Y - W.Max.Y) / N, Rise = (F1 - F0) / N;
