+/** A hardwood in October (or a pine): a trunk and two or three crowns in its colour, standing on the ground at (X, Y). */
+void Tree(HouseCampusPolish::FParts& P, FRandomStream& R, float X, float Y, float Scale = 1.f)
+{
+    static const FName Crowns[] = { TEXT("CPT_LeafRust"), TEXT("CPT_LeafGold"), TEXT("CPT_LeafRed"), TEXT("CPT_LeafGreen"), TEXT("CPT_LeafGold") };
+    const float Z = Slope(X, Y), S = R.FRandRange(.8f, 1.35f) * Scale;
+    if (R.FRand() < .22f)
+    {
+        // A pine: a dark cone over a short trunk.
+        HouseCampusFallKit::Bar(P.Skyline, TEXT("CPT_Trunk"), FVector(X, Y, Z - 20.f), FVector(X, Y, Z + 400.f * S), 24.f * S, 24.f * S, North);
+        HouseCampusFallKit::Lathe(P.Skyline, TEXT("CPT_LeafGreen"), FVector(X, Y, Z + 150.f * S), { FVector2D(260.f * S, 0.f), FVector2D(10.f, 1300.f * S) }, 7);
+        return;
+    }
+    HouseCampusFallKit::Bar(P.Skyline, TEXT("CPT_Trunk"), FVector(X, Y, Z - 20.f), FVector(X, Y, Z + 420.f * S), 30.f * S, 30.f * S, North);
+    const FName Key = Crowns[R.RandRange(0, 4)];
+    for (int32 K = 0; K < 3; ++K)
+        HouseCampusFallKit::Ball(P.Skyline, Key, FVector(X + R.FRandRange(-120.f, 120.f) * S, Y + R.FRandRange(-120.f, 120.f) * S, Z + (520.f + K * 170.f) * S), (300.f - K * 50.f) * S, 6);
+}
