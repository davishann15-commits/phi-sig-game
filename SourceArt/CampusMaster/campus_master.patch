+            bool bOK = true;
+            for (int32 S = 0; S < 5; ++S) bOK &= P.Clear(K.Key + FVector2D(K.Value) * (S * 60.f), 45.f);
+            if (bOK) SI::BikeRack(P, FVector(K.Key, SI::G), K.Value, 5, R);
