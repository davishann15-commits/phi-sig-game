+                S.Step = Now;
+                return;
+            }
+            Advance();
+            return;
+        }
+        if (Now - S.Progress > 7.0)
+        {
+            FCollisionQueryParams Q(SCENE_QUERY_STAT(CampusInteriorsBlocker), false, Pawn);
