+{
+    FRandomStream R(Seed);
+    for (int32 I = 0; I < 9; ++I)
+    {
+        const FVector P = C.At(R.FRandRange(40.f, C.Len - 40.f), R.FRandRange(-140.f, 140.f), StaFloor + .1f);   // (C is the concourse's middle line)
