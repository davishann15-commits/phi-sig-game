+            for (const FVector2D& G : Gaps)
+            {
+                const int32 N = FMath::FloorToInt((G.X - U) / 38.f);
+                if (N > 1) Lockers(Solid, Clutter, FVector(U, P.CorBack + H, Z), FVector(1, 0, 0), N, FVector(0, 1, 0));
+                U = FMath::Max(U, G.Y);
