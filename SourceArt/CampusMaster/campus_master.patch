+bool AHouseCampusPolish::SoundOn() const
+{
+    static const bool bOff = FParse::Param(FCommandLine::Get(), TEXT("NoCampusSound"));
+    return !bOff && GEngine && GEngine->UseSound() && GetNetMode() != NM_DedicatedServer;
