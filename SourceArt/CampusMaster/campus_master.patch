+    SidePair(TEXT("UNI"), TEXT("East"), B, Openings[1], FString(), Out);
+    SidePair(TEXT("UNI"), TEXT("South"), B, Openings[2], FString(), Out);
+    SidePair(TEXT("UNI"), TEXT("North"), B, Openings[3], FString(), Out);
