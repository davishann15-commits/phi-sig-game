+            }
+            if (bThrough) continue;
+            LI::Streamer(P, FVector(Lamps[I], LI::G + 470.f), FVector(Lamps[Best], LI::G + 470.f), Seed++);
+        }
+    }
+    LI::TowerBase(P);
+}
