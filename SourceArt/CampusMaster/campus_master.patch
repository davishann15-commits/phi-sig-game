+    HallMakePlain(Look, TEXT("CI_Walnut"), FLinearColor(.16f, .08f, .035f), .45f);
+    HallMakePlain(Look, TEXT("CI_CrtBezel"), FLinearColor(.03f, .03f, .03f), .4f);
