+    for (int32 I = 0; I < 26; ++I)
+    {
+        const float A = FMath::DegreesToRadians(R.FRandRange(StaLockA0 + 1.f, StaLockA1 - 1.f)), Rr = R.FRandRange(StaLockR0 + .02f, StaLockR1 - .04f);
